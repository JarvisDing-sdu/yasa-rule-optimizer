# YASA 配置（WSL 内的 Linux 路径，请改为你自己的安装路径）
YASA_BUNDLE_PATH=/home/your-username/yasa-bundle
YASA_EXECUTABLE=yasa
UAST_PYTHON_EXE=uast4py-linux-amd64
UAST_GO_EXE=uast4go-linux-amd64

# LLM 配置（DeepSeek 兼容 OpenAI API）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-api-key
LLM_MODEL=deepseek-v4-pro

# 扫描超时（秒），300=5分钟，600=10分钟，1800=30分钟，0=无限制
SCAN_TIMEOUT=300

# Semgrep 离线规则目录（留空则联网拉取 p/xxx 规则集）
# 下载方式：git clone --depth=1 https://github.com/semgrep/semgrep-rules /opt/semgrep-rules
# 然后设置为：SEMGREP_RULES_PATH=/opt/semgrep-rules
SEMGREP_RULES_PATH=

# 认证配置
JWT_SECRET=change-this-to-a-random-secret-key
JWT_EXPIRE_DAYS=30

# SMTP 邮件配置（用于发送验证码）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=码医生
