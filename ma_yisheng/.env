# 扫描超时（秒），300=5分钟，600=10分钟，1800=30分钟，0=无限制
SCAN_TIMEOUT=300

# Semgrep 离线规则目录（留空则联网拉取 p/xxx 规则集）
# 下载方式：git clone --depth=1 https://github.com/semgrep/semgrep-rules /opt/semgrep-rules
# 然后设置为：SEMGREP_RULES_PATH=/opt/semgrep-rules
SEMGREP_RULES_PATH=

