{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GeneratedRule",
  "description": "Schema for YASA rules generated by LLM",
  "type": "object",
  "required": ["checkerIds", "sources", "sinks"],
  "properties": {
    "checkerIds": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "List of checker IDs this rule applies to"
    },
    "sources": {
      "type": "object",
      "description": "Taint source definitions",
      "properties": {
        "TaintSource": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "scopeFile", "scopeFunc"],
            "properties": {
              "path": { "type": "string" },
              "scopeFile": { "type": "string" },
              "scopeFunc": { "type": "string" }
            }
          }
        },
        "FuncCallReturnValueTaintSource": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fsig", "values", "scopeFile", "scopeFunc"],
            "properties": {
              "fsig": { "type": "string" },
              "values": {
                "type": "array",
                "items": { "type": "string" }
              },
              "scopeFile": { "type": "string" },
              "scopeFunc": { "type": "string" }
            }
          }
        },
        "FuncCallArgTaintSource": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fsig", "args", "scopeFile", "scopeFunc"],
            "properties": {
              "fsig": { "type": "string" },
              "args": {
                "type": "array",
                "items": { "type": "string" }
              },
              "scopeFile": { "type": "string" },
              "scopeFunc": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "sinks": {
      "type": "object",
      "description": "Taint sink definitions",
      "properties": {
        "FuncCallTaintSink": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["args", "attribute"],
            "properties": {
              "fsig": { "type": "string" },
              "fregex": { "type": "string" },
              "args": {
                "type": "array",
                "items": { "type": "string" }
              },
              "attribute": { "type": "string" }
            },
            "oneOf": [
              { "required": ["fsig"] },
              { "required": ["fregex"] }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "description": "Metadata for tracking rule generation",
      "properties": {
        "ruleId": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "generatedBy": { "type": "string" },
        "caseId": { "type": "string" },
        "language": { "type": "string" },
        "vulnerabilityType": { "type": "string" },
        "iterationRound": { "type": "integer", "minimum": 1 },
        "validationStatus": { "type": "string", "enum": ["pending", "valid", "invalid"] },
        "evaluationMetrics": {
          "type": "object",
          "properties": {
            "precision": { "type": "number", "minimum": 0, "maximum": 1 },
            "recall": { "type": "number", "minimum": 0, "maximum": 1 },
            "f1": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
